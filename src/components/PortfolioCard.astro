---
interface Props {
  href: string;
  title: string;
  excerpt: string;
  location: string;
  tags: string[];
  cover: string;
}

const { href, title, excerpt, location, tags, cover } = Astro.props;
---

<a class="pcard" href={href}>
  <div class="pcard__media">
    <img src={cover} alt="" loading="lazy" decoding="async" width="640" height="420" />
  </div>
  <div class="pcard__body">
    <p class="pcard__loc muted">{location}</p>
    <h3 class="pcard__title">{title}</h3>
    <p class="pcard__excerpt muted">{excerpt}</p>
    <div class="pcard__tags">
      {tags.slice(0, 4).map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  </div>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-soft);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .pcard:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 55px rgba(44, 42, 38, 0.12);
  }

  .pcard__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .pcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pcard__body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  .pcard__loc {
    font-size: 0.82rem;
    margin: 0;
  }

  .pcard__title {
    font-size: 1.05rem;
    margin: 0;
    line-height: 1.35;
  }

  .pcard__excerpt {
    font-size: 0.92rem;
    margin: 0;
    flex: 1;
  }

  .pcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }
</style>
