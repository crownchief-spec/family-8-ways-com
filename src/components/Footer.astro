---
import { nav, site } from '../site.config';
---

<footer class="site-footer">
  <div class="container grid-2" style="align-items: start;">
    <div>
      <p class="h3" style="margin-bottom: var(--space-sm);">{site.shortName}</p>
      <p class="muted" style="margin: 0; max-width: 40ch;">
        {site.description}
      </p>
      <p style="margin-top: var(--space-md);">
        <a class="btn btn--primary btn--compact" href={site.lineUrl} target="_blank" rel="noopener noreferrer">
          於 Line 與我聯絡
        </a>
      </p>
    </div>
    <div>
      <p class="h3" style="margin-bottom: var(--space-sm);">站內導覽</p>
      <ul class="footer-links">
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
      <p class="muted" style="margin-top: var(--space-md); font-size: 0.9rem;">
        電話：<a href={site.phoneTel}>{site.phone}</a>
      </p>
    </div>
  </div>
  <p class="container muted" style="margin-top: var(--space-xl); font-size: 0.82rem;">
    © {new Date().getFullYear()} {site.shortName}．保留所有權利。
  </p>
</footer>

<style>
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2;
    gap: var(--space-md);
  }

  .footer-links li {
    margin-bottom: 0.35rem;
  }

  .footer-links a {
    text-decoration: none;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .footer-links a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>
