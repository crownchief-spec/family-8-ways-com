---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const title = '爸媽推薦｜小巴老師親子寫真';
const desc =
  '拍攝結束後，最讓我在意的不是一句「照片很漂亮」，而是客人會說：「這真的就是我們家平常的樣子。」';

const items = await getCollection('reviews', ({ data }) => !data.draft);
const sorted = items.sort((a, b) => a.data.sort - b.data.sort);
const rendered = await Promise.all(sorted.map((e) => render(e)));
---

<Layout title={title} description={desc}>
  <section class="hero" style="min-height: 280px; margin-bottom: 0; border-radius: 0;">
    <div
      class="hero__bg"
      style="background-image: url('/images/heroes/family-portrait-japanese-kimono-reviews-006.png');"
    >
    </div>
    <div class="hero__overlay"></div>
    <div class="hero__inner" style="padding-bottom: var(--space-xl);">
      <h1 class="hero__title" style="max-width: none;">爸媽推薦</h1>
      <p class="hero__sub" style="max-width: 54ch;">{desc}</p>
    </div>
  </section>

  <div class="container section">
    <div class="prose muted">
      <p>每一組推薦文字，對我來說都很珍貴。因為那代表照片不只是好看，而是真的有把你們當下的互動與感覺留下來。</p>
      <p>有些爸媽會說，小朋友本來很難控制，但拍起來卻很自然；有些家庭會說，原本只是想簡單拍幾張紀念，結果最後像多了一整段很值得保存的回憶。</p>
    </div>
    <div class="rev-grid">
      {
        sorted.map((entry, i) => {
          const { Content } = rendered[i];
          return (
            <article class="rev card card--flat">
              {entry.data.photo && (
                <div class="rev__photo">
                  <img
                    src={entry.data.photo}
                    alt={`${entry.data.title}｜${entry.data.location} 親子寫真與家庭寫真推薦`}
                    title={`${entry.data.location} 親子寫真與家庭寫真客戶推薦`}
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="520"
                  />
                </div>
              )}
              <div class="rev__body">
                <h2 class="h3">{entry.data.title}</h2>
                <p class="muted" style="margin:0 0 var(--space-sm); font-size:0.92rem;">
                  {entry.data.location} · {entry.data.type}
                </p>
                <div class="prose" style="font-size:0.98rem;">
                  <Content />
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</Layout>

<style>
  .rev-grid {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-md);
  }

  .rev {
    display: grid;
    gap: var(--space-md);
    padding: 0;
    overflow: hidden;
  }

  @media (min-width: 800px) {
    .rev {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
  }

  .rev__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 220px;
  }

  .rev__body {
    padding: var(--space-lg);
  }
</style>
