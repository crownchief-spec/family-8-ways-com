---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { entrySlug } from '../../lib/slug';

const title = '地區拍攝｜台灣與海外親子旅拍';
const desc =
  '每個地區都有適合的家庭旅拍方式。從台灣一日包車，到日本櫻花、沖繩海邊、京都古都，我們把常見地區與拍攝建議整理在這裡。';

const locs = await getCollection('locations', ({ data }) => !data.draft);
const taiwan = locs
  .filter((l) => l.data.region === 'taiwan')
  .sort((a, b) => a.data.sort - b.data.sort);
const overseas = locs
  .filter((l) => l.data.region === 'overseas')
  .sort((a, b) => a.data.sort - b.data.sort);
---

<Layout title={title} description={desc}>
  <section class="hero" style="min-height: 300px; margin-bottom: 0; border-radius: 0;">
    <div
      class="hero__bg"
      style="background-image: url('/images/heroes/kids-portrait-evening-lights-locations-005.png');"
    >
    </div>
    <div class="hero__overlay"></div>
    <div class="hero__inner" style="padding-bottom: var(--space-xl);">
      <h1 class="hero__title" style="max-width: none;">地區拍攝</h1>
      <p class="hero__sub" style="max-width: 58ch;">{desc}</p>
    </div>
  </section>

  <div class="container section">
    <div class="prose muted">
      <p>每個家庭適合的地點都不一樣。有些家庭喜歡草地、樹林與自然感，有些喜歡海邊、黃昏與旅行氛圍，也有些家庭希望安排在來台第一天、離台前最後一天，或是海外旅行中的其中一天。</p>
      <p>我把不同地區的拍攝特點、適合的家庭類型、推薦季節與常見安排方式整理在這裡。你們可以先從想去的地方開始看，也可以直接詢問，我會依照你們的家庭狀況幫你們建議。</p>
    </div>
    <h2 class="h2">台灣地區拍攝</h2>
    <p class="lead">台灣很適合家庭旅拍，對香港家庭來說，也很適合在自由行中安排半日或一日拍攝。</p>
    <div class="loc-grid">
      {
        taiwan.map((l) => (
          <a class="loc-card card card--flat" href={`/locations/${entrySlug(l)}`}>
            <span class="loc-card__title">{l.data.title}</span>
            {l.data.subtitle && <span class="loc-card__sub muted">{l.data.subtitle}</span>}
          </a>
        ))
      }
    </div>
  </div>

  <div class="container section">
    <h2 class="h2">海外地區拍攝</h2>
    <p class="lead">從日本櫻花、古都、和服，到沖繩海邊與東南亞海島，每一種地點都有不同的家庭故事可以拍。</p>
    <div class="loc-grid">
      {
        overseas.map((l) => (
          <a class="loc-card card card--flat" href={`/locations/${entrySlug(l)}`}>
            <span class="loc-card__title">{l.data.title}</span>
            {l.data.subtitle && <span class="loc-card__sub muted">{l.data.subtitle}</span>}
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .loc-grid {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  @media (min-width: 720px) {
    .loc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .loc-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .loc-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-decoration: none;
    color: inherit;
    padding: var(--space-lg);
    transition: transform 0.12s ease;
  }

  .loc-card:hover {
    transform: translateY(-2px);
  }

  .loc-card__title {
    font-weight: 650;
  }

  .loc-card__sub {
    font-size: 0.92rem;
    line-height: 1.5;
  }
</style>
