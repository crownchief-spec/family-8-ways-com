---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PortfolioCard from '../../components/PortfolioCard.astro';
import { entrySlug } from '../../lib/slug';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const locs = await getCollection('locations', ({ data }) => !data.draft);
  return Promise.all(
    locs.map(async (loc) => ({
      params: { slug: entrySlug(loc) },
      props: { loc },
    })),
  );
}

const { loc } = Astro.props;
const { Content } = await render(loc);

const title = `${loc.data.title}｜地區拍攝建議`;
const desc = loc.data.subtitle ?? loc.data.title;

const portfolios = await getCollection('portfolio', ({ data }) => !data.draft);
const key = loc.data.portfolio_match;
const works = key ? portfolios.filter((p) => p.data.location === key).slice(0, 6) : [];

const heroImg =
  loc.data.cover ??
  '/images/heroes/family-portrait-fuji-snow-location-default-011.png';
---

<Layout title={title} description={desc} ogImage={heroImg}>
  <section class="hero" style="min-height: 340px; margin-bottom: 0; border-radius: 0;">
    <div class="hero__bg" style={`background-image: url('${heroImg}')`}></div>
    <div class="hero__overlay"></div>
    <div class="hero__inner" style="padding-bottom: var(--space-xl);">
      <h1 class="hero__title" style="max-width: none;">{loc.data.title}</h1>
      {loc.data.subtitle && <p class="hero__sub" style="max-width: 52ch;">{loc.data.subtitle}</p>}
    </div>
  </section>

  <div class="container section prose">
    <Content />
  </div>

  {
    loc.data.why_great?.length ? (
      <div class="container section">
        <h2 class="h2">為什麼適合拍</h2>
        <ul class="prose">
          {loc.data.why_great.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    ) : null
  }

  {
    loc.data.seasons?.length ? (
      <div class="container section">
        <h2 class="h2">推薦季節與時段</h2>
        <ul class="prose">
          {loc.data.seasons.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    ) : null
  }

  {
    loc.data.family_types?.length ? (
      <div class="container section">
        <h2 class="h2">適合的家庭類型</h2>
        <ul class="prose">
          {loc.data.family_types.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    ) : null
  }

  {
    loc.data.scenes?.length ? (
      <div class="container section">
        <h2 class="h2">推薦拍攝場景</h2>
        <ul class="prose">
          {loc.data.scenes.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    ) : null
  }

  {
    works.length ? (
      <div class="container section">
        <h2 class="h2">真實作品</h2>
        <div class="grid-2">
          {works.map((p) => (
            <PortfolioCard
              href={`/portfolio/${entrySlug(p)}`}
              title={p.data.title}
              excerpt={p.data.excerpt}
              location={p.data.location}
              tags={[...p.data.category, ...p.data.tags].slice(0, 5)}
              cover={p.data.cover}
            />
          ))}
        </div>
      </div>
    ) : null
  }

  {
    loc.data.local_faqs?.length ? (
      <div class="container section">
        <h2 class="h2">常見問題</h2>
        <div class="faq-dl">
          {loc.data.local_faqs.map((item) => (
            <div class="faq-pair">
              <h3 class="h3">{item.q}</h3>
              <p class="muted">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    ) : null
  }

  <div class="container section cta-mini">
    <h2 class="h2">想安排此區親子／家庭旅拍，歡迎直接詢問</h2>
    <div class="hero__actions">
      <a class="btn btn--primary" href={site.lineUrl} target="_blank" rel="noopener noreferrer">
        加 Line 詢問
      </a>
      <a class="btn btn--secondary" href="/contact">預約拍攝</a>
    </div>
  </div>
</Layout>

<style>
  .faq-pair + .faq-pair {
    margin-top: var(--space-md);
  }

  .cta-mini {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: var(--space-xl);
    margin-bottom: var(--space-2xl);
    background: var(--color-paper);
  }
</style>
