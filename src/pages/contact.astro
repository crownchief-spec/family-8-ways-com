---
import Layout from '../layouts/Layout.astro';
import { site } from '../site.config';

const title = '預約詢問｜小巴老師親子寫真';
const desc =
  '請告訴我你們想拍的日期、家庭成員、孩子年齡、地點與想要的風格，我會幫你建議最適合的拍攝方式。';
---

<Layout title={title} description={desc}>
  <section class="hero" style="min-height: 280px; margin-bottom: 0; border-radius: 0;">
    <div
      class="hero__bg"
      style="background-image: url('/images/heroes/family-portrait-kids-playground-contact-008.png');"
    >
    </div>
    <div class="hero__overlay"></div>
    <div class="hero__inner" style="padding-bottom: var(--space-xl);">
      <h1 class="hero__title" style="max-width: none;">預約詢問</h1>
      <p class="hero__sub" style="max-width: 52ch;">{desc}</p>
    </div>
  </section>

  <div class="container section contact-grid">
    <form class="card card--flat contact-form" name="contact" method="post" data-netlify="true">
      <input type="hidden" name="form-name" value="contact" />
      <p class="h3">填寫表單</p>
      <p class="muted" style="margin:0;">如果你現在已經有大概的日期、旅遊地點或預算，可以直接告訴我。如果你還不確定自己適合半天、全天、海外，或只是想先了解香港家庭來台灣適合怎麼安排，也都可以先聯絡我。</p>
      <label class="field">
        <span>姓名</span>
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label class="field">
        <span>Line／聯絡方式</span>
        <input name="contact" type="text" required />
      </label>
      <label class="field">
        <span>預計日期</span>
        <input name="date" type="text" placeholder="例：2026/05 或 可彈性" />
      </label>
      <label class="field">
        <span>拍攝地點</span>
        <input name="location" type="text" />
      </label>
      <label class="field">
        <span>家庭成員與孩子年齡</span>
        <textarea name="family" rows="3"></textarea>
      </label>
      <label class="field">
        <span>想拍半天／全天／海外／客製</span>
        <select name="plan">
          <option value="">請選擇</option>
          <option value="half">台灣半天</option>
          <option value="full">台灣全天</option>
          <option value="overseas">海外旅拍</option>
          <option value="custom">客製方案</option>
        </select>
      </label>
      <label class="field">
        <span>備註</span>
        <textarea name="message" rows="4"></textarea>
      </label>
      <button class="btn btn--primary" type="submit">送出表單</button>
      <p class="muted" style="margin:0;font-size:0.85rem;">
        若部署在非 Netlify 環境，請自行將表單改為 API 或第三方表單服務。
      </p>
    </form>

    <div class="stack">
      <p class="h3">也可以直接這樣聯絡我</p>
      <p class="muted" style="margin:0;">
        你不需要一次把所有細節都想好，只要先給我大方向，我就能幫你一起整理出最適合你們的拍攝方式。
      </p>
      <ul class="prose">
        <li>Line ID：0911252302</li>
        <li>WeChat：{site.wechat}</li>
        <li>WhatsApp：+886 911252302</li>
        <li>Email：{site.email}</li>
      </ul>
      <a class="btn btn--primary" href={site.lineUrl} target="_blank" rel="noopener noreferrer">加 Line 詢問</a>
      <a class="btn btn--secondary" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp 聯絡</a>
    </div>
  </div>
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: start;
    }
  }

  .contact-form {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-lg);
  }

  .field {
    display: grid;
    gap: 0.35rem;
    font-size: 0.92rem;
  }

  .field input,
  .field textarea,
  .field select {
    font: inherit;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--color-line);
    background: #fff;
  }
</style>
